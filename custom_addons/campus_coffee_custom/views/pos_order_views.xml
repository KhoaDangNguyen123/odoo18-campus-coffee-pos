<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_campus_coffee" model="ir.ui.view">
        <field name="name">pos.order.form.campus.coffee</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="order_type" widget="radio" options="{'horizontal': true}"/>
                <field name="barista_status" widget="badge"
                       decoration-warning="barista_status == 'waiting'"
                       decoration-info="barista_status == 'preparing'"
                       decoration-success="barista_status == 'done'"/>
                <field name="barista_note" placeholder="Nhập mức đường, đá hoặc yêu cầu riêng..."/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_campus_coffee" model="ir.ui.view">
        <field name="name">pos.order.tree.campus.coffee</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="order_type"/>
                <field name="barista_status" widget="badge"
                       decoration-warning="barista_status == 'waiting'"
                       decoration-info="barista_status == 'preparing'"
                       decoration-success="barista_status == 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>